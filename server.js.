const express = require("express");
const path = require("path");

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json());

app.get("/", (req, res) => {
  res.sendFile(path.join(__dirname, "index.html"));
});

app.get("/api/status", (req, res) => {
  res.json({
    platform: "MAD Progress Internationaux",
    server: "online",
    wallet: "pending_secure_setup",
    admin: "pending_setup"
  });
});

app.listen(PORT, () => {
  console.log(`MAD Progress server running on port ${PORT}`);
});
